# PostgreSQL connection string (required for Drizzle and connect-pg-simple)
DATABASE_URL=postgresql://user:password@localhost:5432/pocketpulse

# Session signing secret (use a long random string in production)
SESSION_SECRET=change-me-in-production

# development | production | test
NODE_ENV=development

# Listen port for `npm run dev` and production (`npm start`). Replit sets PORT=5000.
# PORT=5000

# Optional: target for `npm run dev:vite` proxy when API runs on a non-default port
# API_PORT=5001

# Browser origin in dev (same as `npm run dev` URL)
APP_ORIGIN=http://localhost:5000

# Canonical public URL in deployed environments.
# Vercel preview example: https://your-preview.vercel.app
# Production example: https://pocketpulse.app
# PUBLIC_APP_URL=

# Optional: enables password reset / transactional emails outside Replit.
# Replit may still use its Resend connector fallback.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Optional: enables "Continue with Google" on sign in / sign up.
# Redirect URI in Google Cloud Console: ${APP_ORIGIN}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Paid enhancement capabilities are off unless explicitly set to "true".
# Configuring OPENAI_API_KEY alone never enables provider traffic.
# POCKETPULSE_TRANSACTION_ENHANCEMENT_ENABLED=false
# POCKETPULSE_CSV_FORMAT_ASSISTANCE_ENABLED=false
# POCKETPULSE_FULL_RECLASSIFY_ENABLED=false

# Slice 6 sandbox billing foundation. Disabled by default. The application
# rejects live Stripe secret keys; do not configure real products or webhooks
# until the separate public-launch approval and readiness review.
# POCKETPULSE_BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_PLUS_PRICE_ID=price_replace_me
# POCKETPULSE_APP_BASE_URL=http://localhost:5000
# POCKETPULSE_PLUS_MONTHLY_PRICE_CENTS=500
# POCKETPULSE_PLUS_TRIAL_DAYS=7
